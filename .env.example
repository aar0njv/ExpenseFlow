ACCOUNT_DB_USER=account_user
ACCOUNT_DB_PASSWORD=change-me-account-password
ACCOUNT_DB_NAME=account_db
ACCOUNT_DATABASE_URL=postgresql+psycopg://account_user:change-me-account-password@account-db:5432/account_db

TRANSACTION_DB_USER=transaction_user
TRANSACTION_DB_PASSWORD=change-me-transaction-password
TRANSACTION_DB_NAME=transaction_db
TRANSACTION_DATABASE_URL=postgresql+psycopg://transaction_user:change-me-transaction-password@transaction-db:5432/transaction_db

REPORT_DB_USER=report_user
REPORT_DB_PASSWORD=change-me-report-password
REPORT_DB_NAME=report_db
REPORT_DATABASE_URL=postgresql+psycopg://report_user:change-me-report-password@report-db:5432/report_db

JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

ACCOUNT_SERVICE_URL=http://account-service:8000
REPORT_ACCOUNT_SERVICE_URL=http://account-service:8000/accounts
REPORT_TRANSACTION_SERVICE_URL=http://transaction-service:8000/transactions/account
